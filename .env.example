# Variables d'environnement pour Make Contrat sur Vercel

# Protection obligatoire de l'espace d'administration (HTTP Basic Auth)
# Recommandé : au moins 15 caractères aléatoires (activer aussi sur les Preview Deployments Vercel)
SITE_PASSWORD=
SITE_USER=admin

# Connexion Upstash Redis (injecté automatiquement par Vercel lors de la connexion de l'intégration)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
